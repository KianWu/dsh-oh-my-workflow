{
  "name": "dsh-oh-my-workflow",
  "version": "0.4.2",
  "description": "oh-my-workflow：开箱即用的 AI 软件交付工作流。借鉴 Karpathy 的 AI 编程四原则（先想清楚、保持简单、只做必要修改、以可验证目标驱动执行）与 Claude Code 的行为系统提示词（信息足够就动手、一轮之内做完、只报告实际发生的事），融合 Matt Pocock 的工程技能包，内置 22 个技能、常驻行为规范段、九段式结构化压缩与“改完必须真验证”的轮次守卫，覆盖需求追问 → 写规格 → 拆工单 → 实现 → 评审 → 验证 → 交接；深入档文档优先、执行解耦，复杂/深入任务自动拆分并行委派子代理以控制上下文，让 AI 交付的代码真正可验收。",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "author": {
    "name": "KianWu",
    "url": "https://github.com/KianWu"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KianWu/dsh-oh-my-workflow.git"
  },
  "homepage": "https://github.com/KianWu/dsh-oh-my-workflow#readme",
  "bugs": {
    "url": "https://github.com/KianWu/dsh-oh-my-workflow/issues"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5",
    "dsh-ops": ">=0.5.5 <0.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "files": [
    "cordis.patch.yml",
    "index.mjs",
    "preset",
    "bin",
    "scripts",
    "test",
    "README.md",
    "CHANGELOG.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "bin": {
    "dsh-oh-my-workflow": "bin/oh-my-workflow.mjs"
  },
  "scripts": {
    "test": "node test/import-smoke.test.mjs && node test/guard.test.mjs && node test/ops-outcome.test.mjs && node test/routing.test.mjs && node test/project-init.test.mjs && node test/uninstall-guard.test.mjs && node scripts/verify-preset.mjs && node scripts/verify-ops-integration.mjs && node scripts/verify-skills.mjs && node scripts/verify-manifest.mjs && node scripts/verify-mount.mjs && node scripts/verify-host-contract.mjs",
    "prepublishOnly": "node scripts/verify-manifest.mjs && node test/import-smoke.test.mjs",
    "init:project": "node scripts/init-project.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "verify:skills": "node scripts/verify-skills.mjs",
    "verify:mount": "node scripts/verify-mount.mjs",
    "verify:ops": "node scripts/verify-ops-integration.mjs",
    "verify:host": "node scripts/verify-host-contract.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "oh-my-workflow",
    "workflow",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
